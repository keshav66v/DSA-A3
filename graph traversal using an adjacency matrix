#include<stdio.h>
#include<stdlib.h>
#define MAX 10
int n;
int adjMatrix[MAX][MAX];
void insertEdge(int u,int v){
    adjMatrix[u][v]=1;
    adjMatrix[v][u]=1;
}
void bfs(int start){
    int queue[MAX], front=0, rear=-1;
    int visited[MAX];
    for(int i=0;i<n;i++)
        visited[i]=0;
    printf("BFS traversal: ");
    queue[++rear]=start;
    visited[start]=1;
    while(front<=rear){
        int v=queue[front++];
        printf("%d ",v);
        for(int i=0;i<n;i++){
            if(visited[i]==0 && adjMatrix[v][i]==1){
                visited[i]=1;
                queue[++rear]=i;
            }
        }
    }
    printf("\n");
}
void dfs(int start){
    int stack[MAX], top=-1;
    int visited[MAX];
    for(int i=0;i<n;i++)
        visited[i]=0;
    printf("DFS traversal: ");
    stack[++top]=start;
    while(top!=-1){
        int v=stack[top--];
        if(visited[v]==0){
            printf("%d ",v);
            visited[v]=1;
        }
        for(int i=0;i<n;i++){
            if(adjMatrix[v][i]==1 && visited[i]==0){
                stack[++top]=i;
            }
        }
    }
    printf("\n");
}
int main(){
    printf("Enter number of vertices: ");
    scanf("%d",&n);
    for(int i=0;i<n;i++)
        for(int j=0;j<n;j++)
            adjMatrix[i][j]=0;
    int choice,u,v,start;
    while(1){
        printf("\n1.Insert Edge\n");
        printf("2.BFS Traversal\n");
        printf("3.DFS Traversal\n");
        printf("4.Exit\n");
        scanf("%d",&choice);
        switch(choice){
            case 1:
                printf("Enter edge (u v): ");
                scanf("%d %d",&u,&v);
                insertEdge(u,v);
                break;
            case 2:
                printf("Enter starting vertex: ");
                scanf("%d",&start);
                bfs(start);
                break;
            case 3:
                printf("Enter starting vertex: ");
                scanf("%d",&start);
                dfs(start);
                break;
            case 4:
                exit(0);
            default:
                printf("Invalid Choice!\n");
        }
    }
}
